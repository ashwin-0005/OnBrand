# Copy to .env.local (never commit real keys). Everything here is FREE to run.

# AI provider: gemini (Google AI Studio free tier) | ollama (local, free) | mock (saved samples)
AI_PROVIDER=mock
# Force mock AI regardless of AI_PROVIDER (demo safety net)
MOCK_AI=false
# Free key from https://aistudio.google.com (no billing needed)
GEMINI_API_KEY=
# Default: gemini-3.5-flash-lite (lightest free-tier model)
GEMINI_MODEL=
# Local Ollama (free; local dev only, Vercel can't reach it). Default model: llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Supabase free tier. Leave URL/anon key empty to use the in-memory demo store (no accounts needed).
# See docs/supabase-setup.md. The anon key is meant to be public; protection comes from row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by 'npm run seed:users' (and verify:supabase cleanup), NEVER by the app or browser.
SUPABASE_SERVICE_ROLE_KEY=
# Password for the 7 seeded demo accounts (min 8 chars). Server only.
DEMO_PASSWORD=

# Free-tier protection: real AI calls per user (cache hits are free). Over the limit -> samples + notice.
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=30
